# Copy to .env for local serverless dev (do not commit .env)
# Stripe Dashboard → Developers → API keys
# Local/preview: sk_test_…   Production: sk_live_… only (enforced in code)

STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe webhook signing secret (Dashboard → Developers → Webhooks → your endpoint).
# Locally, `stripe listen --forward-to localhost:3000/api/stripe-webhook` prints a whsec_… to use.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# --- Optional donation notifications (all off unless set) ---
# Email each donation via Resend (https://resend.com). Needs all three:
# RESEND_API_KEY=re_your_key
# DONATION_NOTIFY_EMAIL=you@yourorg.org           # who gets the alert
# DONATION_FROM_EMAIL=donations@yourdomain.org    # a sender on a Resend-verified domain
#
# Append each donation to a Google Sheet via an Apps Script web app (see README):
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Local/preview only: skip Stripe in the checkout route. Ignored when CONTEXT=production or SITE_ENV=production.
# MOCK_CHECKOUT=1

# Production + deploy previews: canonical public origin (no trailing slash)
# PUBLIC_SITE_URL=https://www.yoursite.org

# Production servers where Netlify does not set CONTEXT=production (Vercel included):
# set so mock mode is off and sk_test_ keys are rejected
# SITE_ENV=production

# --- Newsletter signup (footer form) ---
# Preferred: add subscribers straight to a Resend Audience.
# RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Fallback while the audience is being set up — each signup is emailed instead.
# NEWSLETTER_TO=info@jdiobestem.org
# NEWSLETTER_FROM=news@yourdomain.org

# --- Django backend (backend/) --------------------------------------------
# The volunteer, newsletter, project-proposal and donation paths all go through
# it now: it validates, stores in Postgres, and sends the notification email.
# BACKEND_API_KEY must match SERVICE_API_KEY in backend/.env, and is
# server-to-server only — never expose it as NEXT_PUBLIC_*.
BACKEND_API_URL=http://localhost:8000/api
BACKEND_API_KEY=dev-service-key-change-me
