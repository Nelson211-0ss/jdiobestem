# Copy to backend/.env for local work. Docker Compose reads this file too.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,admin.localhost
DJANGO_TIME_ZONE=Africa/Kampala

# Hostname the dashboard answers on. Everything else serves the API only.
# Production: admin.jdiobestem.org
ADMIN_HOST=admin.localhost

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=jdiobe
POSTGRES_USER=jdiobe
POSTGRES_PASSWORD=jdiobe
POSTGRES_HOST=localhost      # 'db' inside Docker Compose
POSTGRES_PORT=5432

# --- The website ----------------------------------------------------------
# Shared secret the Next.js route handlers send as X-API-Key.
# Server-to-server only — never expose it through NEXT_PUBLIC_*.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY=dev-service-key-change-me

SITE_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Notification email (optional; off unless RESEND_API_KEY is set) -------
# Submissions are stored either way. This only controls the email staff receive.
RESEND_API_KEY=
NOTIFY_FROM=Jdiobe STEM Foundation <onboarding@resend.dev>
NOTIFY_TO=info@jdiobestem.org

# --- Object storage: Cloudflare R2 ----------------------------------------
# Uploads go to the local filesystem until all four of these are set, so a
# fresh clone runs without live storage keys.
#
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API token
# (Object Read & Write, scoped to this bucket).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket's public hostname: the r2.dev URL, or a custom domain you have
# attached to the bucket. Without it, media URLs are time-limited signed links,
# which is fine privately but useless in an <img src> on the public site.
R2_PUBLIC_URL=

# Defaults to https://<account-id>.r2.cloudflarestorage.com — only set this if
# you use a jurisdiction-specific endpoint (EU, FedRAMP).
R2_ENDPOINT_URL=

UPLOAD_MAX_BYTES=15728640

# --- monday.com sync ------------------------------------------------------
# Personal API token: monday.com -> your avatar -> Developers -> My access
# tokens. Used only by `manage.py sync_monday`; boards stay at their last
# import without it.
MONDAY_API_TOKEN=
